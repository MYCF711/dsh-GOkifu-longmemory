{
  "name": "dsh-gokifu-longmemory",
  "version": "0.8.14",
  "private": true,
  "description": "DSH 长期记忆系统（棋院 / Kifu-in）：棋谱入馆、相关边成网、定式可更新；只在相关时顺藤摸瓜。私有自用，不发 npm。",
  "type": "module",
  "main": "src/plugin.mjs",
  "exports": {
    ".": "./src/plugin.mjs",
    "./plugin": "./src/plugin.mjs",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./client.js",
    "./tools": "./src/tools-plugin.mjs"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "src",
    "scripts/archive.mjs",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
